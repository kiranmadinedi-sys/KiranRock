# ============================================================
#  KiranRock Trading Platform — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of allowed frontend origins (production only)
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kiranrock_trading
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ── Auth ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ── Data Provider ────────────────────────────────────────────
# yahoo | alpaca | polygon
DATA_PROVIDER=yahoo

# ── Alpaca Markets (required when DATA_PROVIDER=alpaca or BROKER=alpaca) ──
ALPACA_KEY_ID=your_alpaca_key_id
ALPACA_SECRET_KEY=your_alpaca_secret_key
# Set to 'false' to trade with real money (default: paper trading)
ALPACA_PAPER=true

# ── Polygon.io (required when DATA_PROVIDER=polygon) ─────────
POLYGON_API_KEY=your_polygon_api_key

# ── Broker ───────────────────────────────────────────────────
# simulated | alpaca
BROKER=simulated
BOT_ENABLED=true
MAX_BOT_INVESTMENT_USD=5000

# ── Telegram Alerts ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Email Alerts ─────────────────────────────────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
# Use a Gmail App Password (not your main password)
EMAIL_PASSWORD=your_gmail_app_password

# ── Bot Service Account (used by schedulers to fetch predictions) ──
BOT_USERNAME=user
BOT_PASSWORD=password

# ── News / Sentiment APIs (all optional — 'demo' key gives limited access) ──
NEWSAPI_KEY=your_newsapi_key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key
FINNHUB_KEY=your_finnhub_key
HUGGINGFACE_API_KEY=your_huggingface_api_key

# ── AI Scoring Tuning ────────────────────────────────────────
AI_NEWS_SCORING_ENABLED=true
AI_NEWS_SCORE_WEIGHT=1
AI_NEWS_MAX_IMPACT=8

# ── Circuit Breakers ─────────────────────────────────────────
# Halt trading after this many consecutive losing trades
CIRCUIT_HALT_STREAK=5
# Reduce position sizes after this many consecutive losing trades
CIRCUIT_REDUCE_STREAK=3
# Halt if portfolio drops more than this % from peak
MAX_DRAWDOWN_PCT=15
# Halt if market data is older than this many milliseconds (default 2 min)
DATA_MAX_AGE_MS=120000

# ── Stock Universe ───────────────────────────────────────────
# ALL | SP500 | TOP_200 | WATCHLIST
STOCK_UNIVERSE=TOP_200

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info

# ── AI Provider Rate Limiting ────────────────────────────────
AI_PROVIDER_429_THRESHOLD=3
AI_PROVIDER_COOLDOWN_MS=600000
AI_PROVIDER_LOG_THROTTLE_MS=60000

# ── News Sentiment Cache ─────────────────────────────────────
NEWS_SENTIMENT_CACHE_MS=1800000
NEWS_SENTIMENT_STALE_MS=21600000
NEWS_SENTIMENT_MAX_ARTICLES=12

# ── PANTHEON: PROPHET Earnings Forecaster ───────────────────
# Days-to-earnings window in which PROPHET fires (default 15-45)
PROPHET_WINDOW_MIN_DAYS=15
PROPHET_WINDOW_MAX_DAYS=45

# ── PANTHEON: Gemini PULSE (AI news sentiment analyst) ───────
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional: default is gemini-2.0-flash-lite (free tier friendly)
GEMINI_MODEL=gemini-2.0-flash-lite

# ── PANTHEON: FRED Macro Service (SHIELD macro regime) ───────
# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key

# ── PANTHEON: Reddit Alt Data (SONAR retail sentiment) ───────
# Register a free "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_SECRET=your_reddit_secret
# Optional — identifies your bot to Reddit (required by API policy)
REDDIT_USER_AGENT=KiranRockBot/1.0

# ── PANTHEON: HERMES Universe Filter ─────────────────────────
# Minimum market cap for a stock to enter the trading universe
HERMES_MIN_MARKET_CAP=5000000000
# Minimum 30-day average daily volume
HERMES_MIN_AVG_VOLUME=500000
# Maximum number of stocks to hold in the universe at once
HERMES_MAX_STOCKS=150

# ── PANTHEON: COMPASS Sector Rotation ────────────────────────
# Number of trading days to look back for sector RS calculation
COMPASS_LOOKBACK_DAYS=20
# Cache TTL in milliseconds (default 30 min)
COMPASS_CACHE_TTL_MS=1800000

# ── PANTHEON: Activation Gates ───────────────────────────────
# Set to 'true' to enforce step-up gates (hard block without enough history)
# Leave 'false' (default) to log gate status without blocking
ACTIVATION_GATES_ENFORCE=false

# ── PANTHEON: Finnhub (SONAR smart money) ────────────────────
# Required for institutional ownership + insider transaction signals
FINNHUB_API_KEY=your_finnhub_api_key

# ── Autonomous trading kill switch ───────────────────────────
# Set to 'false' to pause all AI-initiated trades without stopping the process.
# EOD cleanup and position monitoring still run. Default: true.
AI_TRADING_ENABLED=true

# ── ORACLE Claude fallback (cost protection) ─────────────────
# ORACLE always prefers local Ollama (zero cost). If Ollama is down, Claude
# is only used as a fallback when this is explicitly set to 'true' AND
# ANTHROPIC_API_KEY is present. Default false = code-score-only when Ollama down.
ORACLE_ALLOW_CLAUDE_FALLBACK=false
